# Copia a .env.docker (no se versiona) y completa. Compose lee estos mismos valores
# con «docker compose --env-file .env.docker ...» (no uses el .env de desarrollo).
# Añade también DB_ROOT_PASSWORD y COMPREFACE_POSTGRES_PASSWORD.
APP_NAME=Encontrarnos
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=encontrarnos
DB_USERNAME=encontrarnos
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

RECORDS_SEARCH=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX=person_records

COMPREFACE_ENABLED=true
COMPREFACE_AUTO_INDEX=true
COMPREFACE_HOST=http://compreface-fe
COMPREFACE_API_KEY=
COMPREFACE_THRESHOLD=0.30
COMPREFACE_TIMEOUT=20

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
ADMIN_NOTIFICATION_EMAIL=
